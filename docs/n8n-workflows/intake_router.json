    {
      "parameters": {
        "jsCode": "\nfunction text(v) {\n  if (Array.isArray(v)) return v.join(' ').toLowerCase();\n  return String(v || '').toLowerCase();\n}\nfunction pickTier(row) {\n  const urgency = text(row.urgency);\n  const role = text(row.role);\n  const volume = text(row.volume);\n  const notes = text(row.notes);\n  if ((urgency.includes('24') || urgency.includes('48') || urgency.includes('this week') || urgency.includes('need it now')) && (role.includes('solo') || role.includes('team') || role.includes('acquisition'))) {\n    return ['Imminent Auction Hot Sheet', 'Urgency signal says they need records immediately, so route them to the fastest verified-auction offer. Operator should confirm market fit and send one focused quote.'];\n  }\n  if (role.includes('acquisition') || notes.includes('cold call') || notes.includes('daily') || volume.includes('daily')) {\n    return ['Fresh Triggers Feed', 'Acquisitions/calling cadence suggests they need fresh trigger flow, not a static bulk list. Operator should position freshness and first-mover timing.'];\n  }\n  if (volume.includes('500') || volume.includes('1500') || notes.includes('quality') || notes.includes('debt') || notes.includes('equity')) {\n    return ['The Breaking Point', 'Volume and quality signals point to a tighter high-conversion subset. Operator should frame this around motivation density and debt/pressure signals.'];\n  }\n  return ['Curated Distress List', 'General intake with no high-urgency/team signal. Operator should start with the foundational curated list and match the first market cleanly.'];\n}\nconst rows = Array.isArray($json) ? $json : ($json.data || ($json.id ? [$json] : []));\nreturn rows.map((row) => {\n  const [recommended_tier, recommendation_note] = pickTier(row);\n  return { json: { ...row, recommended_tier, recommendation_note } };\n});\n"
      },
